# yaml-language-server: $schema=https://github.com/epics-containers/ibek/releases/download/3.1.2/ibek.support.schema.json
ioc_name: {{iocname}}
description: Granville-Phillips 307 vacuum gauges on a shared RS-485 line

entities:
- type: granville307.gateway
  name: GRANVILLE307_MOXA
  IP: "{{server}}"
  TCPPORT: {{port | default(4008)}}
  PROTO: "{{protocol | default('granville307-rs485.proto')}}"

{%- for dev in devices %}
- type: granville307.controller
  gateway: GRANVILLE307_MOXA
  name: "{{dev.name}}"
  P: "{{iocprefix}}:{{dev.name}}"
  ADDR: "{{ "%02X" | format(dev.address | int) }}"
  PRES_UNIT_DEFAULT: "{{unit_default | default(1)}}"
- type: epics.DbAlias
  name: "{{iocprefix}}:{{dev.name}}:{{dev.channel}}:PRES_RB"
  alias: "{{iocprefix}}:{{dev.name}}:PRES_RB"
- type: epics.DbAlias
  name: "{{iocprefix}}:{{dev.name}}:{{dev.channel}}:STATE_RB"
  alias: "{{iocprefix}}:{{dev.name}}:STATE_RB"
{%- endfor %}

- type: epics.PostStartupCommand
  command: |
      dbl("*") > {{config_dir}}/pvlist.txt
      dbl
